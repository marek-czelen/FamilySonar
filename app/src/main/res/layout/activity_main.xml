<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/mainLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10sp"
    android:orientation="vertical">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/logo_item"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp"
        android:text="Family Sonar v.1.0"
        app:layout_constraintLeft_toRightOf="@id/logoImage"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/infoLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="65dp"
        android:gravity="left"
        android:text="Lokalizator rodzinny"

        app:layout_constraintBottom_toTopOf="@id/locationInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/textView" />
    <TextView
        android:id="@+id/locationInfo"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="[0,0]"
        android:background="@drawable/rounded_corner"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="3dp"
        android:paddingTop="3dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintStart_toEndOf="@id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/infoLine1"
        />
    <TextView android:id="@+id/locationTimeout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintStart_toEndOf="@id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/locationInfo"
        android:text="0.0s"
        />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/loationAddress"
        android:paddingLeft="16dp"
        android:layout_marginTop="7dp"
        android:text="address"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintBottom_toTopOf="@id/separator1"

        />

    <View
        android:id="@+id/separator1"
        app:layout_constraintTop_toBottomOf="@id/loationAddress"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/dark_gray" />

    <TextView
        android:id="@+id/powerSaverInfo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separator1"
        app:layout_constraintRight_toLeftOf="@id/batteryOptimalizationButton"
        android:layout_marginTop="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/design_default_color_primary_dark"
        android:text="UWAGA !!. Wyłącz oszczędzanie baterii i harmonogram oszczędzania baterii."/>

    <Button
        android:id="@+id/batteryOptimalizationButton"
        android:layout_marginTop="0dp"
        android:layout_width="130sp"
        android:layout_height="40sp"
        android:layout_alignParentRight="true"
        android:gravity="right"
        android:text="Ustawienia"
        android:theme="@style/Theme.AppCompat.Dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@id/powerSaverInfo"
        app:layout_constraintTop_toBottomOf="@id/separator1"
        app:layout_constraintBottom_toTopOf="@id/separator2"
        />

    <View
        android:id="@+id/separator2"
        app:layout_constraintTop_toBottomOf="@id/powerSaverInfo"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_gray" />

    <TextView
        android:id="@+id/perissionInfo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separator2"
        app:layout_constraintRight_toLeftOf="@id/batteryOptimalizationButton"
        android:layout_marginTop="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="UWAGA !!. Musisz przyznać wszyskie, żądane przez oplikację upawnienia."/>
    <Button
        android:id="@+id/permissionButton"
        android:layout_marginTop="0dp"
        android:layout_width="130sp"
        android:layout_height="40sp"
        android:layout_alignParentRight="true"
        android:gravity="right"
        android:text="Uprawnienia"
        android:theme="@style/Theme.AppCompat.Dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@id/powerSaverInfo"
        app:layout_constraintTop_toBottomOf="@id/separator2"
        app:layout_constraintBottom_toTopOf="@id/separator3"
        />

    <View
        android:id="@+id/separator3"
        app:layout_constraintTop_toBottomOf="@id/perissionInfo"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/dark_gray" />

    <TextView
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/separator3"
        android:id="@+id/labelPhoneList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2sp"
        android:text="Udostępnij lokalizację poniższym numerom:"
        android:textFontWeight="700"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        app:layout_constraintTop_toBottomOf="@id/labelPhoneList"
        android:id="@+id/contactList"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_below="@id/labelPhoneList"
        android:layout_marginLeft="5sp"
        android:layout_height="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="20sp"
        android:layout_marginBottom="20sp"
        android:src="@android:drawable/ic_input_add" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSOS"
        app:tint="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="20sp"
        app:maxImageSize="56dp"
        android:src="@drawable/sos" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>