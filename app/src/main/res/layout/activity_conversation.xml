<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safe_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/conversationHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/safe_surface"
        android:elevation="2dp"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/safe_on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/conversationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/safe_on_background"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conversationSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sms_mode"
                android:textColor="@color/safe_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mmsInfoButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mms_limited_title"
            android:src="@drawable/ic_info"
            app:tint="@color/safe_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/threadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_info"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:padding="10dp"
        android:text="@string/sms_mms_scope_banner"
        android:textColor="@color/safe_on_surface"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/attachmentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/safe_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/safe_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/attachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:adjustViewBounds="true"
        android:background="@color/safe_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/messageComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/safe_surface"
        android:elevation="4dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/emojiButton"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji_button"
            android:src="@drawable/ic_emoji" />

        <ImageButton
            android:id="@+id/attachmentButton"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attachment_button"
            android:src="@drawable/ic_attach" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/message_input_background"
            android:hint="@string/message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/send_button_background"
            android:contentDescription="@string/send_message"
            android:src="@drawable/ic_send" />
    </LinearLayout>

</LinearLayout>
